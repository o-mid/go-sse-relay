LISTEN_ADDR=127.0.0.1:8080
# Hosted platforms (Railway/Render/Fly) usually set PORT instead.
# If LISTEN_ADDR is empty and PORT is set, the relay binds 0.0.0.0:$PORT.
INSTANCE_ID=relay-1

# Optional shared secret for ingest HMAC (hex sha256 in X-Signature).
HOOK_SECRET=

# When set, GET /v1/stream requires a signed channel token.
STREAM_SECRET=

# Secret used to mint tokens via POST /v1/tokens.
# Falls back to HOOK_SECRET, then STREAM_SECRET.
TOKEN_MINT_SECRET=
TOKEN_TTL_SECONDS=3600

REPLAY_CAPACITY=64
SUBSCRIBER_BUFFER=16

# Fan-out bus: memory | redis | nats
BUS=memory
REDIS_URL=redis://127.0.0.1:6379/0
NATS_URL=nats://127.0.0.1:4222
